# Copy to .env or .env.local and fill in — both are gitignored (.env.local wins).
# Used by scripts/generateShopTeacherDataset.ts, scripts/labelDisagreements.ts,
# and scripts/distillPolicy.ts to call the Claude teacher model.
ANTHROPIC_API_KEY=

# Standalone game server (yarn serve, after yarn build).
HOST=0.0.0.0
PORT=8080
# Comma-separated external browser origins, optional when proxy preserves Host.
PUBLIC_ORIGINS=
# Empty permits trusted intranet clients. If set, harness requests need Bearer auth.
MCP_AUTH_TOKEN=
# For the optional stdio adapter; HTTP MCP connects directly to /mcp.
BROWSLATRO_URL=http://127.0.0.1:8080
